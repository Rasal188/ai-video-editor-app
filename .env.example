# ==========================================
# AI Video Editor - Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_video_editor
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false

# Media / Archive Storage (Local filesystem for dev, S3/blob in production)
STORAGE_DIRECTORY=storage
MAX_UPLOAD_SIZE_BYTES=524288000

# Authentication (Passwordless Email OTP)
AUTH_OTP_EXPIRES_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_SESSION_DURATION_DAYS=7
AUTH_COOKIE_NAME=timeline_session
AUTH_SALT=replace-with-a-secure-random-salt

# Email Delivery Provider (mock | ollastack)
EMAIL_PROVIDER=mock

# OllaStack Email Configuration (Required if EMAIL_PROVIDER=ollastack)
# Official documentation: https://login.ollastack.com/api/openapi.json
# Base URL defaults to https://login.ollastack.com
OLLASTACK_BASE_URL=https://login.ollastack.com
# API Bearer token created in OllaStack Dashboard -> Settings -> API tokens (requires mail.agent:send or mail.test:send scope)
OLLASTACK_API_KEY=
# ID of the mailbox created/claimed in OllaStack (POST /api/mailboxes or Dashboard)
OLLASTACK_MAILBOX_ID=

# Optional Ollalink cloud transcription (server only; local remains default)
# Create an approved GPU API key at login.ollalink.com -> Platform -> GPU API keys.
# Sent as X-NH-GPU-Key, NOT a dashboard/partner Bearer token. Never prefix with VITE_.
# Documentation: https://voices.networkershome.com/docs/speech-to-text/
OLLALINK_API_KEY=

# Ollima AI Natural-Language Editing Assistant
# Official documentation: https://api.ollima.com/v1/ / https://ollama.com/v1
OLLIMA_API_KEY=
# Configurable model identifier supported by Ollima (e.g. gemini-3-flash, gemini-3.1-flash-lite, gemma4)
OLLIMA_MODEL=gemini-3-flash
# Base URL for Ollima API (default: https://api.ollima.com/v1)
OLLIMA_BASE_URL=https://api.ollima.com/v1
# Request timeout in milliseconds (default: 30000)
OLLIMA_TIMEOUT_MS=30000
